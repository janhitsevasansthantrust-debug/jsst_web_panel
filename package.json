{
  "name": "new-trust-project",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "node --test \"src/**/*.test.js\"",
    "test:watch": "node --test --watch \"src/**/*.test.js\"",
    "create-owner": "node --conditions=react-server --env-file=.env.local scripts/create-owner.js",
    "whoami": "node --conditions=react-server --env-file=.env.local scripts/whoami.js",
    "reindex": "node --conditions=react-server --env-file=.env.local scripts/reindex.js",
    "repair:closings": "node --conditions=react-server --env-file=.env.local scripts/repair-closing-ledgers.js",
    "verify:closings": "node --conditions=react-server scripts/verify-closing-lifecycle.js",
    "emulator": "firebase emulators:start --only firestore --project demo-trust",
    "rules:fetch": "node --conditions=react-server --env-file=.env.local scripts/fetch-live-rules.js",
    "check": "node scripts/check-imports.js",
    "deploy:indexes": "node --env-file=.env.local scripts/deploy.js indexes",
    "deploy:storage": "node --env-file=.env.local scripts/deploy.js storage",
    "deploy:rules": "node --env-file=.env.local scripts/deploy.js rules",
    "deploy:all": "node --env-file=.env.local scripts/deploy.js all",
    "migrate:flatten": "node --conditions=react-server --env-file=.env.local scripts/migrate-members-flat.js",
    "i18n:extract": "node scripts/extract-strings.js",
    "backfill:keywords": "node --conditions=react-server --env-file=.env.local scripts/backfill-keywords.js",
    "migrate": "node --conditions=react-server --env-file=.env.local scripts/migrate-old.js"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "@ant-design/nextjs-registry": "^1.1.0",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@react-pdf/renderer": "^4.3.1",
    "@tanstack/react-query": "^5.90.8",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "antd": "^5.28.1",
    "antd-img-crop": "^4.27.0",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "nanoid": "^5.1.5",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.90.8",
    "acorn": "^8.14.0",
    "acorn-jsx": "^5.3.2",
    "tailwindcss": "^4"
  }
}
